          "tbelScript": "// timestamp: prova da msg.ts (gateway), altrimenti da metadata.ts/timestamp, altrimenti null\nvar t = null;\n\nif (msg.ts != null) {\n  t = msg.ts;\n} else if (metadata.ts != null) {\n  t = metadata.ts;\n} else if (metadata.timestamp != null) {\n  t = metadata.timestamp;\n}\n\n// telemetria: se arriva come {values:{...}} usa values, altrimenti usa msg\nvar m = msg;\nif (msg.values != null) {\n  m = msg.values;\n}\n\n// impacchetta tutto nel body che verrà inviato dal REST API Call (che manda solo msg)\nreturn {\n  msg: {\n    msg: m,\n    metadata: metadata,\n    timestamp: t\n  },\n  metadata: metadata,\n  msgType: msgType\n};"
